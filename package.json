{
  "name": "menki-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit",
    "start": "node dist/server/main.js",
    "dev": "tsx src/server/main.ts",
    "test": "tsx --test test/*.test.ts",
    "backup:verify": "node dist/server/backup-cli.js",
    "launch": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "10.1.11",
    "@fontsource/inter": "^5.3.0",
    "@openai/codex": "0.170.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.55.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
